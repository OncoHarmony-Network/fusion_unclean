stringr::str_remove(".Rdata")
for (t in types) {
message("Processing ", t)
f = fl[grepl(t, fl)]
load(f)
expr.all.signature_integration$Index = NULL
rd = expr.all.signature_integration |>
mutate(ID = gsub("\\.", "-", ID)) |>
as.data.table()
t2 = sub("_", "-", t)
f2 = file.path(outpath, paste0(t2, "_IOBR_signature.tsv.gz"))
message("Writing to ", f2)
fwrite(rd, f2, sep = "\t")
}
for (t in cohorts) {
message("Processing ", t)
f = fl[grepl(t, fl)]
load(f)
expr.all.signature_integration$Index = NULL
rd = expr.all.signature_integration |>
mutate(ID = gsub("\\.", "-", ID)) |>
as.data.table()
t2 = sub("_", "-", t)
f2 = file.path(outpath, paste0(t2, "_IOBR_signature.tsv.gz"))
message("Writing to ", f2)
fwrite(rd, f2, sep = "\t")
}
